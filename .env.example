# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://alphaboard:alphaboard@localhost:5434/alphaboard?schema=public"

# ── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"

# First admin, created once by `npm run db:seed` (registration is invite-only)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── AI providers (at least one) — only providers with a key appear as choices ─
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
# Optional initial default (admins can change it in Admin → AI), e.g. openai / gpt-5.4-mini
AI_DEFAULT_PROVIDER=""
AI_DEFAULT_MODEL=""

# ── Market data / news (optional) ─────────────────────────────────────────────
NEWS_API_KEY=""
CRYPTOPANIC_KEY=""

# ── Jobs / notifications (optional) ───────────────────────────────────────────
CRON_SECRET=""
TELEGRAM_BOT_TOKEN=""

# Scheduler (paper trading SL/TP; later alerts + signal evaluation). Runs every 60s in-process.
# TICK_DISABLED=1
