# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://alphaboard:alphaboard@localhost:5434/alphaboard?schema=public"

# ── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"

# First admin, created once by `npm run db:seed` (registration is invite-only)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── AI providers (at least one) — only providers with a key appear as choices ─
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
# Optional initial default (admins can change it in Admin → AI), e.g. openai / gpt-5.4-mini
AI_DEFAULT_PROVIDER=""
AI_DEFAULT_MODEL=""

# ── Market data / news (optional) ─────────────────────────────────────────────
NEWS_API_KEY=""
CRYPTOPANIC_KEY=""

# ── Jobs / notifications (optional) ───────────────────────────────────────────
CRON_SECRET=""
TELEGRAM_BOT_TOKEN=""

# Background worker: 60s tick (paper SL/TP, equity, signal grading, alerts), 15s agent-session monitor,
# Telegram long-polling. inline (default) = inside the web process; separate = run `npm run worker` too.
# WORKER_MODE=inline
# TICK_DISABLED=1

# ── Exchange sessions (P8b, optional) ─────────────────────────────────────────
# Both are required before anyone can connect an exchange (owner/admin only).
# LIVE_TRADING_ENABLED=1
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored exchange API keys; keep it secret and stable.
# EXCHANGE_KEY_SECRET=
# Emergency stop: refuses every new entry on every exchange session (exits still run).
# TRADING_HALT=1
