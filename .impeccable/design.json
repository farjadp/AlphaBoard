      "css": ".ds-seg{display:inline-flex;padding:2px;gap:2px;border:1px solid var(--color-line);border-radius:4px;background:var(--color-wash)}.ds-seg-i{padding:4px 12px;border:0;border-radius:3px;background:transparent;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:12px;font-weight:600;color:var(--color-ink-2);cursor:pointer;transition:background-color 150ms,color 150ms}.ds-seg-i:hover:not([aria-pressed=true]){background:var(--color-paper);color:var(--color-ink)}.ds-seg-i[aria-pressed=true]{background:var(--color-ink);color:var(--color-paper)}.ds-seg-i:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
