      "html": "<header class=\"ds-mast\"><a class=\"ds-brand\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\" aria-hidden=\"true\"><ellipse cx=\"11\" cy=\"11\" rx=\"9.5\" ry=\"9.5\" stroke=\"var(--color-ink)\" stroke-width=\"1.5\"/><ellipse cx=\"11\" cy=\"11\" rx=\"5.5\" ry=\"4\" stroke=\"var(--color-accent)\" stroke-width=\"1.5\"/><path d=\"M3.5 15.5 L8.5 10.5 L12 13 L18.5 6\" stroke=\"var(--color-ink)\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>AlphaBoard</a><nav class=\"ds-nav\"><a class=\"ds-nav-a\" aria-current=\"page\">Markets</a><a class=\"ds-nav-a\">Paper</a><a class=\"ds-nav-a\">Performance</a></nav><span class=\"ds-clock\">14:05 UTC</span></header>",
      "css": ".ds-mast{display:flex;align-items:center;gap:32px;height:56px;padding:0 24px;background:var(--color-paper);border-bottom:2px solid var(--color-ink);font-family:\"Public Sans\",system-ui,sans-serif}.ds-brand{display:flex;align-items:center;gap:8px;font-size:17px;font-weight:800;letter-spacing:-.02em;color:var(--color-ink)}.ds-nav{display:flex;align-self:stretch;gap:2px}.ds-nav-a{position:relative;display:flex;align-items:center;padding:0 12px;font-size:13px;font-weight:600;color:var(--color-ink-2);cursor:pointer;transition:color 150ms}.ds-nav-a:hover{color:var(--color-ink)}.ds-nav-a[aria-current=page]{color:var(--color-ink)}.ds-nav-a[aria-current=page]::after{content:\"\";position:absolute;left:8px;right:8px;bottom:0;height:3px;background:var(--color-accent)}.ds-clock{margin-left:auto;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px;font-weight:600;letter-spacing:.06em;color:var(--color-ink-3)}"
    }
