      "css": ".ds-chip{padding:3px 9px;border:1px solid var(--color-line-2);border-radius:3px;background:transparent;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px;font-weight:600;color:var(--color-ink-3);cursor:pointer;transition:border-color 150ms,color 150ms,background-color 150ms}.ds-chip:hover{color:var(--color-ink);border-color:var(--color-ink-3)}.ds-chip[aria-pressed=true]{color:var(--color-accent);border-color:var(--color-accent);background:var(--color-accent-soft)}.ds-chip:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
