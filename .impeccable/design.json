      "css": ".ds-sheet{background:var(--color-paper);border:1px solid var(--color-line);border-top:3px solid var(--color-ink);border-radius:0;box-shadow:0 1px 0 rgb(0 0 0 / .02),0 10px 24px -18px rgb(10 16 27 / .25);padding:20px;font-family:\"Public Sans\",system-ui,sans-serif;color:var(--color-ink)}.ds-label{margin:0;font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--color-ink-3)}.ds-num{margin:2px 0 0;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-variant-numeric:tabular-nums;font-size:17px;font-weight:600}"
