generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String?
  role                 Role      @default(USER)
  disclaimerAcceptedAt DateTime?
  aiProvider           String?
  aiModel              String?
  dailyTokenQuota      Int       @default(200000)
  /// Telegram delivery (P6): chat linked via `/start <code>` sent to the bot.
  telegramChatId       String?   @unique
  telegramLinkCode     String?   @unique
  telegramLinkExpires  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  invitesCreated Invite[]   @relation("InviteCreator")
  inviteUsed     Invite?    @relation("InviteConsumer")
  auditLogs      AuditLog[]

  watchlist      WatchlistItem[]
  attachments    Attachment[]
  journalEntries JournalEntry[]
  tradeLessons   TradeLesson[]
  signals        Signal[]
  chartLessons   ChartLesson[]
  priceAlerts    PriceAlert[]
  aiUsage        AiUsage[]
  paperAccount   PaperAccount?
  notifications  Notification[]
}

model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String?
  role        Role      @default(USER)
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteConsumer", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ─── User data (P2) ──────────────────────────────────────────────────────────
// Every row is owned by a user; repositories in lib/db always filter by userId.
// legacyId = the id the row had in browser localStorage, so /import is idempotent.

enum TradePosition {
  LONG
  SHORT
  SPOT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum AlertCondition {
  above
  below
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  position  Int
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId, position])
}

/// Uploaded images (trade screenshots, chart studies). Compressed client-side to ≤1.5 MB.
model Attachment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime      String
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now())

  journalEntries JournalEntry[]

  @@index([userId])
}

model JournalEntry {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId        String?
  symbol          String
  position        TradePosition
  status          TradeStatus   @default(OPEN)
  entryPrice      Float
  exitPrice       Float?
  pnlPercent      Float?
  grossPnlPercent Float?
  feeRatePercent  Float?
  pnlSource       String?
  emotion         String
  notes           String        @default("")
  leverage        Float?
  margin          Float?
  marginMode      String?
  screenshotId    String?
  screenshot      Attachment?   @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  postMortem      Json?
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lesson TradeLesson?

  @@unique([userId, legacyId])
  @@index([userId, openedAt])
}

model TradeLesson {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId       String?
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  symbol         String
  position       TradePosition
  outcome        String
  pnlPercent     Float?
  timeframe      String?
  rootCause      String
  mistakes       String[]
  strengths      String[]
  lesson         String
  tags           String[]
  emotion        String?
  createdAt      DateTime      @default(now())

  @@unique([userId, legacyId])
  @@index([userId, createdAt])
}

/// Every AI strategy report, archived at generation time with the price the model saw.
model Signal {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId            String?
  symbol              String
  timeframe           String
  signal              String
  confidence          Int
  priceAtSignal       Float
  entry               Float
  stopLoss            Float
  takeProfit          Float
  tradeStyle          String?
  riskManagement      Json?
  supportResistance   Json?
  safeEntries         Json?
  reasoning           String
  indicatorsBreakdown Json?
  provider            String
  model               String
  createdAt           DateTime @default(now())

  paperPositions PaperPosition[]
  evaluation     SignalEvaluation?

  @@unique([userId, legacyId])
  @@index([userId, createdAt])
  @@index([symbol, createdAt])
}

model ChartLesson {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId        String?
  symbol          String?
  overallSignal   String
  confluenceScore Int
  summary         String
  lesson          String
  patterns        String[]
  tags            String[]
  mistakes        String[]
  strengths       String[]
  /// [{ timeframe, attachmentId, annotations, signal, bias }]
  charts          Json
  createdAt       DateTime @default(now())

  @@unique([userId, legacyId])
  @@index([userId, createdAt])
}

model PriceAlert {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId      String?
  symbol        String
  targetPrice   Float
  condition     AlertCondition
  triggered     Boolean        @default(false)
  triggeredAt   DateTime?
  /// Price at which the server saw the level cross (the level itself, or the open on a gap).
  triggerPrice  Float?
  /// Candles that started before this time have already been checked.
  lastCheckedAt DateTime       @default(now())
  createdAt     DateTime       @default(now())

  @@unique([userId, legacyId])
  @@index([userId, triggered])
}

// ─── AI usage (P3) ───────────────────────────────────────────────────────────

/// One row per model call (successful or not): who, which model, tokens, estimated cost, outcome.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  latencyMs    Int      @default(0)
  status       String
  errorCode    String?
  /// Requested model that refused; `model` is the server-side fallback that answered.
  fallbackFrom String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─── Paper trading (P4) ──────────────────────────────────────────────────────
// Isolated margin, market orders. Math lives in lib/paper/engine.ts; persistence in lib/paper/account.ts.

enum PaperSide {
  LONG
  SHORT
}

enum PaperCloseReason {
  MANUAL
  STOP_LOSS
  TAKE_PROFIT
  LIQUIDATION
}

enum PaperOrderAction {
  BUY
  SELL
}

model PaperAccount {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingBalance Float
  cashBalance     Float
  currency        String    @default("USDT")
  /// Last time the tick wrote an equity snapshot for this account.
  snapshotAt      DateTime?
  resetAt         DateTime?
  createdAt       DateTime  @default(now())

  positions PaperPosition[]
  orders    PaperOrder[]
  equity    EquitySnapshot[]
}

model PaperPosition {
  id            String            @id @default(cuid())
  accountId     String
  account       PaperAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol        String
  side          PaperSide
  qty           Float
  entryPrice    Float
  leverage      Float
  margin        Float
  stopLoss      Float?
  takeProfit    Float?
  signalId      String?
  signal        Signal?           @relation(fields: [signalId], references: [id], onDelete: SetNull)
  /// Entry + exit taker fees charged so far.
  fees          Float
  openedAt      DateTime          @default(now())
  /// Candles that started before this time have already been scanned for SL/TP.
  lastCheckedAt DateTime          @default(now())
  closedAt      DateTime?
  closePrice    Float?
  realizedPnl   Float?
  closeReason   PaperCloseReason?

  orders PaperOrder[]

  @@index([accountId, closedAt])
  @@index([closedAt, symbol])
}

model PaperOrder {
  id             String           @id @default(cuid())
  accountId      String
  account        PaperAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  positionId     String?
  position       PaperPosition?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  symbol         String
  action         PaperOrderAction
  type           String           @default("MARKET")
  qty            Float
  requestedPrice Float
  fillPrice      Float
  slippage       Float
  fee            Float
  status         String           @default("FILLED")
  reason         String?
  createdAt      DateTime         @default(now())

  @@index([accountId, createdAt])
}

model EquitySnapshot {
  id        String       @id @default(cuid())
  accountId String
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equity    Float
  at        DateTime     @default(now())

  @@index([accountId, at])
}

// ─── Signal evaluation (P5) ──────────────────────────────────────────────────
// Outcome of each archived BUY/SELL signal replayed on later candles (lib/eval/evaluator.ts).

enum SignalOutcome {
  OPEN
  TP_HIT
  SL_HIT
  EXPIRED
  NO_FILL
  INVALID
}

model SignalEvaluation {
  id            String        @id @default(cuid())
  signalId      String        @unique
  signal        Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)
  status        SignalOutcome
  rMultiple     Float?
  exitPrice     Float?
  entryFilledAt DateTime?
  resolvedAt    DateTime?
  barsElapsed   Int           @default(0)
  note          String?
  lastCheckedAt DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([status, lastCheckedAt])
}

// ─── Notifications (P6) ──────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// price_alert | paper_close
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ─── Access requests / waitlist (P7) ─────────────────────────────────────────
// Public landing form; admins turn a request into an invite from Admin → Invites.

enum AccessRequestStatus {
  PENDING
  INVITED
  DISMISSED
}

model AccessRequest {
  id        String              @id @default(cuid())
  email     String              @unique
  name      String?
  note      String?
  status    AccessRequestStatus @default(PENDING)
  ip        String?
  inviteId  String?
  handledAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt])
}

// ─── Operations (P7 admin dashboard) ─────────────────────────────────────────

/// Server-side errors worth an admin's attention (5xx, render errors, tick failures).
/// Repeats of the same failure (same fingerprint) within 10 minutes bump `count` instead of adding rows.
model SystemEvent {
  id          String   @id @default(cuid())
  level       String
  source      String
  message     String
  fingerprint String
  count       Int      @default(1)
  requestId   String?
  meta        Json?
  firstAt     DateTime @default(now())
  lastAt      DateTime @default(now())

  @@index([lastAt])
  @@index([fingerprint, lastAt])
}
