generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String?
  role                 Role      @default(USER)
  disclaimerAcceptedAt DateTime?
  aiProvider           String?
  aiModel              String?
  dailyTokenQuota      Int       @default(200000)
  /// Telegram delivery (P6): chat linked via `/start <code>` sent to the bot.
  telegramChatId       String?   @unique
  telegramLinkCode     String?   @unique
  telegramLinkExpires  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  invitesCreated Invite[]   @relation("InviteCreator")
  inviteUsed     Invite?    @relation("InviteConsumer")
  auditLogs      AuditLog[]

  watchlist       WatchlistItem[]
  attachments     Attachment[]
  journalEntries  JournalEntry[]
  tradeLessons    TradeLesson[]
  signals         Signal[]
  chartLessons    ChartLesson[]
  priceAlerts     PriceAlert[]
  aiUsage         AiUsage[]
  paperAccount    PaperAccount?
  notifications   Notification[]
  tradingSessions TradingSession[]
  tradingLimits   UserTradingLimits?
  telegramActions TelegramAction[]
}

model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String?
  role        Role      @default(USER)
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteConsumer", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ─── User data (P2) ──────────────────────────────────────────────────────────
// Every row is owned by a user; repositories in lib/db always filter by userId.
// legacyId = the id the row had in browser localStorage, so /import is idempotent.

enum TradePosition {
  LONG
  SHORT
  SPOT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum AlertCondition {
  above
  below
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  position  Int
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@index([userId, position])
}

/// Uploaded images (trade screenshots, chart studies). Compressed client-side to ≤1.5 MB.
model Attachment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime      String
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now())

  journalEntries JournalEntry[]

  @@index([userId])
}

model JournalEntry {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId          String?
  symbol            String
  position          TradePosition
  status            TradeStatus   @default(OPEN)
  entryPrice        Float
  exitPrice         Float?
  pnlPercent        Float?
  grossPnlPercent   Float?
  feeRatePercent    Float?
  pnlSource         String?
  emotion           String
  notes             String        @default("")
  leverage          Float?
  margin            Float?
  marginMode        String?
  screenshotId      String?
  /// Set when the entry was written by an agent trading session (P8).
  sessionPositionId String?       @unique
  screenshot        Attachment?   @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  postMortem        Json?
  openedAt          DateTime      @default(now())
  closedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lesson TradeLesson?

  @@unique([userId, legacyId])
  @@index([userId, openedAt])
}

model TradeLesson {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId       String?
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  symbol         String
  position       TradePosition
  outcome        String
  pnlPercent     Float?
  timeframe      String?
  rootCause      String
  mistakes       String[]
  strengths      String[]
  lesson         String
  tags           String[]
  emotion        String?
  createdAt      DateTime      @default(now())

  @@unique([userId, legacyId])
  @@index([userId, createdAt])
}

/// Every AI strategy report, archived at generation time with the price the model saw.
model Signal {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId            String?
  symbol              String
  timeframe           String
  signal              String
  confidence          Int
  priceAtSignal       Float
  entry               Float
  stopLoss            Float
  takeProfit          Float
  tradeStyle          String?
  riskManagement      Json?
  supportResistance   Json?
  safeEntries         Json?
  reasoning           String
  indicatorsBreakdown Json?
  provider            String
  model               String
  createdAt           DateTime @default(now())

  paperPositions PaperPosition[]
  evaluation     SignalEvaluation?

  @@unique([userId, legacyId])
  @@index([userId, createdAt])
  @@index([symbol, createdAt])
}

model ChartLesson {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId        String?
  symbol          String?
  overallSignal   String
  confluenceScore Int
  summary         String
  lesson          String
  patterns        String[]
  tags            String[]
  mistakes        String[]
  strengths       String[]
  /// [{ timeframe, attachmentId, annotations, signal, bias }]
  charts          Json
  createdAt       DateTime @default(now())

  @@unique([userId, legacyId])
  @@index([userId, createdAt])
}

model PriceAlert {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId      String?
  symbol        String
  targetPrice   Float
  condition     AlertCondition
  triggered     Boolean        @default(false)
  triggeredAt   DateTime?
  /// Price at which the server saw the level cross (the level itself, or the open on a gap).
  triggerPrice  Float?
  /// Candles that started before this time have already been checked.
  lastCheckedAt DateTime       @default(now())
  createdAt     DateTime       @default(now())

  @@unique([userId, legacyId])
  @@index([userId, triggered])
}

// ─── AI usage (P3) ───────────────────────────────────────────────────────────

/// One row per model call (successful or not): who, which model, tokens, estimated cost, outcome.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  latencyMs    Int      @default(0)
  status       String
  errorCode    String?
  /// Requested model that refused; `model` is the server-side fallback that answered.
  fallbackFrom String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─── Paper trading (P4) ──────────────────────────────────────────────────────
// Isolated margin, market orders. Math lives in lib/paper/engine.ts; persistence in lib/paper/account.ts.

enum PaperSide {
  LONG
  SHORT
}

enum PaperCloseReason {
  MANUAL
  STOP_LOSS
  TAKE_PROFIT
  LIQUIDATION
}

enum PaperOrderAction {
  BUY
  SELL
}

model PaperAccount {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingBalance Float
  cashBalance     Float
  currency        String    @default("USDT")
  /// Last time the tick wrote an equity snapshot for this account.
  snapshotAt      DateTime?
  resetAt         DateTime?
  createdAt       DateTime  @default(now())

  positions PaperPosition[]
  orders    PaperOrder[]
  equity    EquitySnapshot[]
}

model PaperPosition {
  id            String            @id @default(cuid())
  accountId     String
  account       PaperAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol        String
  side          PaperSide
  qty           Float
  entryPrice    Float
  leverage      Float
  margin        Float
  stopLoss      Float?
  takeProfit    Float?
  signalId      String?
  signal        Signal?           @relation(fields: [signalId], references: [id], onDelete: SetNull)
  /// Entry + exit taker fees charged so far.
  fees          Float
  openedAt      DateTime          @default(now())
  /// Candles that started before this time have already been scanned for SL/TP.
  lastCheckedAt DateTime          @default(now())
  closedAt      DateTime?
  closePrice    Float?
  realizedPnl   Float?
  closeReason   PaperCloseReason?

  orders PaperOrder[]

  @@index([accountId, closedAt])
  @@index([closedAt, symbol])
}

model PaperOrder {
  id             String           @id @default(cuid())
  accountId      String
  account        PaperAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  positionId     String?
  position       PaperPosition?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  symbol         String
  action         PaperOrderAction
  type           String           @default("MARKET")
  qty            Float
  requestedPrice Float
  fillPrice      Float
  slippage       Float
  fee            Float
  status         String           @default("FILLED")
  reason         String?
  createdAt      DateTime         @default(now())

  @@index([accountId, createdAt])
}

model EquitySnapshot {
  id        String       @id @default(cuid())
  accountId String
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equity    Float
  at        DateTime     @default(now())

  @@index([accountId, at])
}

// ─── Signal evaluation (P5) ──────────────────────────────────────────────────
// Outcome of each archived BUY/SELL signal replayed on later candles (lib/eval/evaluator.ts).

enum SignalOutcome {
  OPEN
  TP_HIT
  SL_HIT
  EXPIRED
  NO_FILL
  INVALID
}

model SignalEvaluation {
  id            String        @id @default(cuid())
  signalId      String        @unique
  signal        Signal        @relation(fields: [signalId], references: [id], onDelete: Cascade)
  status        SignalOutcome
  rMultiple     Float?
  exitPrice     Float?
  entryFilledAt DateTime?
  resolvedAt    DateTime?
  barsElapsed   Int           @default(0)
  note          String?
  lastCheckedAt DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([status, lastCheckedAt])
}

// ─── Notifications (P6) ──────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// price_alert | paper_close
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ─── Access requests / waitlist (P7) ─────────────────────────────────────────
// Public landing form; admins turn a request into an invite from Admin → Invites.

enum AccessRequestStatus {
  PENDING
  INVITED
  DISMISSED
}

model AccessRequest {
  id        String              @id @default(cuid())
  email     String              @unique
  name      String?
  note      String?
  status    AccessRequestStatus @default(PENDING)
  ip        String?
  inviteId  String?
  handledAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt])
}

// ─── Operations (P7 admin dashboard) ─────────────────────────────────────────

/// Server-side errors worth an admin's attention (5xx, render errors, tick failures).
/// Repeats of the same failure (same fingerprint) within 10 minutes bump `count` instead of adding rows.
model SystemEvent {
  id          String   @id @default(cuid())
  level       String
  source      String
  message     String
  fingerprint String
  count       Int      @default(1)
  requestId   String?
  meta        Json?
  firstAt     DateTime @default(now())
  lastAt      DateTime @default(now())

  @@index([lastAt])
  @@index([fingerprint, lastAt])
}

// ─── Agent trading sessions (P8) ─────────────────────────────────────────────

enum SessionStatus {
  RUNNING
  PAUSED
  AWAITING_EXTENSION
  ENDING
  ENDED
  HALTED
}

enum SessionEndReason {
  COMPLETED
  USER_ENDED
  LOSS_LIMIT
  KILL
  RECONCILE_MISMATCH
  LLM_BUDGET
  ERROR
  EXTENSION_TIMEOUT
}

enum SessionRole {
  MARKET
  NEWS
  BULL
  BEAR
  STRATEGIST
  RISK
  EXECUTOR
  JOURNAL
  SYSTEM
  USER
}

enum SessionMessageKind {
  TEXT
  PROPOSAL
  VERDICT
  ORDER
  FILL
  ALERT
  REPORT
}

enum SessionOrderStatus {
  PENDING
  OPEN
  PARTIAL
  FILLED
  CANCELED
  REJECTED
  UNKNOWN
}

enum SessionOrderPurpose {
  ENTRY
  EXIT
  STOP
  TAKE_PROFIT
}

enum SessionCloseReason {
  MANUAL
  STRATEGIST
  STOP_LOSS
  TAKE_PROFIT
  LIQUIDATION
  LOSS_LIMIT
  KILL
  SESSION_END
}

/// A time-boxed run of the agent team under a frozen mandate (spec P8 §3).
model TradingSession {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  status             SessionStatus     @default(RUNNING)
  live               Boolean           @default(false)
  venue              String            @default("paper")
  mandate            Json
  capital            Float
  startedAt          DateTime          @default(now())
  endsAt             DateTime
  endedAt            DateTime?
  endReason          SessionEndReason?
  realizedPnl        Float             @default(0)
  fees               Float             @default(0)
  llmCostUsd         Float             @default(0)
  tradesCount        Int               @default(0)
  cycleCount         Int               @default(0)
  skipStreak         Int               @default(0)
  agentFailStreak    Int               @default(0)
  llmBudgetHit       Boolean           @default(false)
  lastCycleAt        DateTime?
  nextCycleAt        DateTime?
  /// Prices at the last decision cycle / at start (symbol → price), for event triggers and buy-and-hold.
  lastPrices         Json?
  startPrices        Json?
  extensionPromptAt  DateTime?
  extensionChatId    String?
  extensionMessageId Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  positions SessionPosition[]
  orders    SessionOrder[]
  messages  SessionMessage[]
  report    SessionReport?
  actions   TelegramAction[]

  @@index([userId, createdAt])
  @@index([status])
}

model SessionPosition {
  id             String              @id @default(cuid())
  sessionId      String
  session        TradingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  symbol         String
  side           PaperSide
  qty            Float
  entryPrice     Float
  leverage       Float
  margin         Float
  stopLoss       Float?
  takeProfit     Float?
  /// Strategist exit plan (take profit, stop, invalidation, horizon, thesis, initial stop) — re-injected every cycle.
  exitPlan       Json
  /// Entry + exit fees charged so far.
  fees           Float               @default(0)
  openedAt       DateTime            @default(now())
  closedAt       DateTime?
  closePrice     Float?
  realizedPnl    Float?
  closeReason    SessionCloseReason?
  journalEntryId String?             @unique

  orders SessionOrder[]

  @@index([sessionId, closedAt])
}

model SessionOrder {
  id            String              @id @default(cuid())
  sessionId     String
  session       TradingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  positionId    String?
  position      SessionPosition?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  /// Deterministic id sent to the venue; a replay returns the existing order instead of filling twice.
  clientOrderId String              @unique
  venueOrderId  String?
  symbol        String
  side          PaperOrderAction
  type          String              @default("market")
  purpose       SessionOrderPurpose
  reduceOnly    Boolean             @default(false)
  amount        Float
  price         Float?
  status        SessionOrderStatus  @default(PENDING)
  filled        Float               @default(0)
  avgPrice      Float?
  fee           Float?
  error         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([sessionId, createdAt])
}

model SessionMessage {
  id        String             @id @default(cuid())
  sessionId String
  session   TradingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      SessionRole
  kind      SessionMessageKind @default(TEXT)
  body      String
  data      Json?
  costUsd   Float?
  cycle     Int?
  createdAt DateTime           @default(now())

  @@index([sessionId, createdAt])
}

model SessionReport {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   TradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  summary   String
  metrics   Json
  lessons   Json
  createdAt DateTime       @default(now())
}

/// Account-wide limits across all sessions of a day (spec E19).
model UserTradingLimits {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxDailyLoss      Float?
  maxSessionsPerDay Int?
  updatedAt         DateTime @updatedAt
}

/// Opaque token behind a Telegram inline button (callback_data), valid 24 h, single use.
model TelegramAction {
  token      String          @id
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    TradingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  action     String
  positionId String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime        @default(now())

  @@index([expiresAt])
}
