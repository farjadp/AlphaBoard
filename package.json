{
  "name": "tradeflow",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:db": "TEST_DATABASE_URL=postgresql://alphaboard:alphaboard@localhost:5434/alphaboard?schema=test vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "lightweight-charts": "^5.2.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "pino": "^10.3.1",
    "prisma": "^6.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
